// The Metal version of crt.frag.hlsl, with the bindings SDL's Metal backend expects
#include <metal_stdlib>
using namespace metal;

struct Context
{
    float2 texture_size;
    float2 output_scale;
};

struct main0_in
{
    float4 v_color [[user(locn0)]];
    float2 v_uv [[user(locn1)]];
    float4 v_position [[position]];
};

struct main0_out
{
    float4 o_color [[color(0)]];
};

constant float ScanlineDepth = 0.5;
constant float GrilleDepth = 0.12;
constant float Brightness = 1.2;

fragment main0_out main0(main0_in in [[stage_in]], constant Context& context [[buffer(0)]],
                         texture2d<float> u_texture [[texture(0)]], sampler u_sampler [[sampler(0)]])
{
    main0_out out = {};
    float2 texel = in.v_uv * context.texture_size;
    float4 color = u_texture.sample(u_sampler, (floor(texel) + 0.5) / context.texture_size) * in.v_color;

    float gap = saturate(fract(texel.y) * 2.0 - 1.0);
    float scanline = 1.0 - ScanlineDepth * saturate(context.output_scale.y - 1.0) * gap;

    int column = int(in.v_position.x) % 3;
    float3 grille = float3(1.0 - GrilleDepth);
    grille[column] = 1.0;

    out.o_color = float4(saturate(color.rgb * scanline * grille * Brightness), color.a);
    return out;
}
